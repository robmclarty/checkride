{
  "version": "0.2",
  "language": "en",
  "files": ["**/src/**/*.ts", "**/test/**/*.ts", "**/*.md"],
  "ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    ".check/**",
    "pnpm-lock.yaml",
    "package.json",
    "CHANGELOG.md"
  ],
  "ignoreRegExpList": ["/v1[0-9a-f]{16}/g"],
  "words": [
    "checkride",
    "baselined",
    "biome",
    "cspell",
    "devDeps",
    "esbuild",
    "eslint",
    "fallow",
    "knip",
    "markdownlint",
    "NodeNext",
    "noemit",
    "oxlint",
    "oxlintrc",
    "pnpm",
    "sgconfig",
    "stryker",
    "tsbuildinfo",
    "tsconfig",
    "tsgolint",
    "vitest"
  ]
}
