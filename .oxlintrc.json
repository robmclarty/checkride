{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn",
    "style": "off"
  },
  "options": {
    "typeAware": true
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-explicit-any": "error",
    "typescript/await-thenable": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/prefer-optional-chain": "error",
    "no-console": "warn",
    "eqeqeq": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off",
        // These suites mutate one shared directory: read-then-write the same file,
        // or apply an edit, run the CLI, assert, revert. Awaiting in the loop IS
        // the correctness constraint, and a perf rule has no claim on test code.
        "no-await-in-loop": "off"
      }
    }
  ],
  "ignorePatterns": [
    "dist/**",
    ".check/**",
    ".claude/**",
    "node_modules/**",
    "scripts/**",
    "site/**",
    "examples/**"
  ]
}
