{
  "version": "0.2",
  "language": "en,en-GB",
  "unknownWords": "report-common-typos",
  "files": [
    "src/**/*.ts",
    "test/**/*.ts",
    "site/**/*.html",
    "**/*.md"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    ".check/**",
    "pnpm-lock.yaml",
    "package.json",
    "plans/**",
    "research/**",
    "CHANGELOG.md"
  ],
  "ignoreRegExpList": [
    "/v1[0-9a-f]{16}/g",
    "/data:image\\/svg\\+xml[^\"]*/g",
    "/data-site=\"[A-Z]+\"/g"
  ],
  "words": []
}
