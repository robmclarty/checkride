node_modules/
dist/
.check/
.fallow/
.stryker-tmp/
coverage/
*.log
*.tsbuildinfo
.DS_Store
.claude/settings.local.json
.claude/worktrees/
.pnpm-store/
stryker.incremental.json

# Local scratch/exploration notes — never part of the package
research/

# Examples install independently; their lockfiles would be churn, not a
# reproducibility guarantee (each package.json already pins exact versions).
examples/*/pnpm-lock.yaml

# Bytecode a Python tool writes when run by hand in an example, and the
# frozen 0.13 polyglot subject's compileall check writes in its copy.
__pycache__/

# The providers and modules `tofu init` installs when a Terraform example is
# run by hand; its committed .terraform.lock.hcl pins what they are.
.terraform/
