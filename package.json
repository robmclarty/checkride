{
  "name": "checkride",
  "version": "0.13.0",
  "description": "An agent harness for code repositories: one command that is the definition of done, plus mechanically enforced module boundaries. TypeScript-first, not TypeScript-only.",
  "license": "Apache-2.0",
  "author": "Rob McLarty",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robmclarty/checkride.git"
  },
  "homepage": "https://robmclarty.github.io/checkride/",
  "bugs": "https://github.com/robmclarty/checkride/issues",
  "type": "module",
  "keywords": [
    "agent",
    "typescript",
    "lint",
    "check",
    "ci",
    "deep-modules",
    "boundaries"
  ],
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=9.0.0"
  },
  "bin": {
    "checkride": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "templates",
    "schema",
    ".claude-plugin",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --build && node dist/cli.js",
    "check:all": "tsc --build && node dist/cli.js --all",
    "check:json": "tsc --build && node dist/cli.js --json",
    "check:bail": "tsc --build && node dist/cli.js --bail",
    "check:changed": "tsc --build && node dist/cli.js --changed",
    "check:fix": "tsc --build && node dist/cli.js fix",
    "doctor": "tsc --build && node dist/cli.js doctor",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsc --build && vitest run --config vitest.e2e.config.ts",
    "mutation": "stryker run",
    "build": "tsc --build",
    "build:clean": "tsc --build --clean",
    "types": "tsc --build",
    "prepublishOnly": "tsc --build && vitest run"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@ast-grep/cli": "0.45.3",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "4.1.11",
    "@vvago/vale": "3.24.0",
    "ajv": "8.20.0",
    "cspell": "10.3.6",
    "fallow": "3.31.0",
    "markdownlint-cli2": "0.23.3",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "publint": "0.3.25",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
