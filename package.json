{
  "name": "checkride",
  "version": "0.1.0",
  "description": "An agent harness for TypeScript repositories: one command that is the definition of done, plus mechanically enforced module boundaries.",
  "license": "MIT",
  "author": "Rob McLarty",
  "type": "module",
  "keywords": [
    "agent",
    "typescript",
    "lint",
    "check",
    "ci",
    "deep-modules",
    "boundaries"
  ],
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "check:all": "node scripts/check.mjs --all",
    "check:json": "node scripts/check.mjs --json",
    "check:bail": "node scripts/check.mjs --bail",
    "check:changed": "node scripts/check.mjs --changed",
    "check:fix": "pnpm exec oxlint --type-aware --fix && pnpm exec fallow fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --build",
    "build:clean": "tsc --build --clean",
    "types": "tsc --build"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.42.1",
    "@types/node": "24.12.2",
    "@vitest/coverage-v8": "4.1.5",
    "cspell": "10.0.0",
    "fallow": "2.48.0",
    "markdownlint-cli2": "0.22.1",
    "oxlint": "1.61.0",
    "oxlint-tsgolint": "0.21.1",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  }
}
