{
  "openapi": "3.1.0",
  "info": {
    "title": "Orders",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness probe",
        "responses": { "200": { "description": "The service is up" } }
      }
    },
    "/orders": {
      "get": {
        "summary": "List orders",
        "responses": { "200": { "description": "An array of orders" } }
      },
      "post": {
        "summary": "Place an order",
        "responses": { "201": { "description": "The created order" } }
      }
    }
  }
}
