    {
      "name": "a failing test",
      "edits": [{ "file": "tests/test_pricing.py", "find": "assert subtotal_cents([]) == 0", "replace": "assert subtotal_cents([]) == 1" }],
      "exitCode": 1,
      "failing": ["test"]
    },
    {
      "name": "a print in library code",
      "edits": [{ "file": "src/reporting.py", "find": "    total = subtotal_cents(items)\n", "replace": "    total = subtotal_cents(items)\n    print(\"cart\", items)\n" }],
      "exitCode": 1,
      "failing": ["struct"],
      "structRules": ["no-print-in-src"]
