{
  "description": "A Python project on the python pack: ruff, mypy and pytest from the uv-synced .venv, ast-grep rules in Python, and one custom check, each failing on its own plant.",
  "args": [],
  "requires": ["uv", "ast-grep"],
  "setup": [["uv", "sync"]],
  "exitCode": 0,
  "checks": {
    "lint": { "ok": true, "skipped": false, "description": "ruff: Python lint" },
    "types": { "ok": true, "skipped": false, "description": "mypy: Python type checking" },
    "test": { "ok": true, "skipped": false, "description": "pytest: Python tests" },
